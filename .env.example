# Optional. Leave unset to run in deterministic demo mode (no paid API needed).
AI_PROVIDER=demo
AI_API_KEY=replace_me
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_RETRIES=2
AI_TIMEOUT_MS=30000
PORT=8000
DATABASE_PATH=./data/incrubrix.sqlite
APP_ORIGIN=http://127.0.0.1:5173
# Optional Firebase Admin service-account JSON path (keep the key private).
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
